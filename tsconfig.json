{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ]
    },
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "apps",
    "packages",
    "scripts",
    "tests"
  ],
  "exclude": [
    "apps/web",
    "node_modules"
  ]
}