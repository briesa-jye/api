# --- Public ---
NEXT_PUBLIC_SITE_URL=https://api.briesa.com
# Where customers send API requests: the separate Node host running apps/api
NEXT_PUBLIC_API_BASE_URL=https://gateway.briesa.com
SUPPORT_EMAIL=support@briesa.com

# --- Database (same Postgres as the API; Supabase session pooler string, Sydney region) ---
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Supabase calls this the publishable key (sb_publishable_...). The older name NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Stripe (leave unset until billing is ready; pricing and subscribe show "contact us") ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON array. Prices and currency live in Stripe; this maps a Stripe price to the packs it licenses.
# BRIESA_PLANS=[{"id":"pro","name":"Pro","priceId":"price_...","packs":["*"],"description":"All packs, live keys"}]
BRIESA_PLANS=

# --- Local preview only. Ignored in production. Signs in a fake user with seeded demo data (in-memory). ---
# DEMO_AUTH=1
