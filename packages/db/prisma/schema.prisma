generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  retentionDays      Int                 @default(365)
  createdAt          DateTime            @default(now())
  // Billing. Self-serve tenants start with status "none" (sandbox only); billingExempt tenants are provisioned by Briesa.
  billingExempt      Boolean             @default(false)
  stripeCustomerId   String?             @unique
  subscriptionStatus String              @default("none")
  subscriptionId     String?
  planId             String?
  licensedPacks      String[]            @default([])
  currentPeriodEnd   DateTime?
  // Stripe event time of the last billing update applied, so out-of-order webhook deliveries cannot roll state back.
  billingEventAt     DateTime?
  keys               ApiKey[]
  usage              UsageEvent[]
  audits             AuditRecord[]
  idempotency        IdempotencyRecord[]
  endpoints          WebhookEndpoint[]
  deliveries         WebhookDelivery[]
  tenantMembers      TenantMember[]
}

model ApiKey {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  name               String
  prefix             String    @unique
  hash               String
  mode               String // "test" | "live"
  scopes             String[]
  rateLimitPerMinute Int       @default(60)
  createdAt          DateTime  @default(now())
  revokedAt          DateTime?
  rotatedFromId      String?
  kind               String    @default("secret") // "secret" | "publishable"
  allowedOrigins     String[]  @default([])
  monthlyCap         Int?
  publicKey          String?

  @@index([tenantId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  keyId     String
  packId    String?
  endpoint  String
  test      Boolean
  month     String // "YYYY-MM"
  createdAt DateTime @default(now())

  @@index([tenantId, month])
}

// Append-only. The application never updates or deletes rows except via the retention job.
model AuditRecord {
  id           String   @id @default(cuid())
  requestId    String
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  keyId        String
  endpoint     String
  packId       String?
  packVersion  String?
  ruleVersions Json?
  inputsHash   String
  output       Json?
  model        String?
  test         Boolean
  reference    String?
  createdAt    DateTime @default(now())

  @@unique([tenantId, requestId])
  @@index([tenantId, createdAt])
  @@index([tenantId, reference])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  key          String
  requestHash  String
  status       Int
  responseBody String
  createdAt    DateTime @default(now())

  @@unique([tenantId, key])
}

model WebhookEndpoint {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  url        String
  events     String[]
  packs      String[]
  secret     String // AES-256-GCM "enc:v1:..." when WEBHOOK_SECRET_KEY is set; legacy rows may be plaintext
  createdAt  DateTime          @default(now())
  disabledAt DateTime?
  deliveries WebhookDelivery[]

  @@index([tenantId])
}

model RateWindow {
  key         String
  windowStart DateTime
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
}

model WebhookDelivery {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id])
  event          String
  payload        String
  status         String // pending | succeeded | failed
  attempts       Int             @default(0)
  lastStatusCode Int?
  lastError      String?
  nextAttemptAt  DateTime?
  createdAt      DateTime        @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([tenantId, endpointId])
}

// A signed-in dashboard user (Supabase Auth user id) and the tenant they manage. One tenant per user for now.
model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String   @unique
  email     String
  role      String   @default("owner")
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// Stripe event ids already processed, so webhook retries are idempotent.
model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}
