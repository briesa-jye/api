generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  retentionDays Int      @default(365)
  createdAt     DateTime @default(now())
  keys          ApiKey[]
}

model ApiKey {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  name               String
  prefix             String    @unique
  hash               String
  mode               String // "test" | "live"
  scopes             String[]
  rateLimitPerMinute Int       @default(60)
  createdAt          DateTime  @default(now())
  revokedAt          DateTime?
  rotatedFromId      String?

  @@index([tenantId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  tenantId  String
  keyId     String
  packId    String?
  endpoint  String
  test      Boolean
  month     String // "YYYY-MM"
  createdAt DateTime @default(now())

  @@index([tenantId, month])
}

// Append-only. The application never updates or deletes rows except via the retention job.
model AuditRecord {
  id           String   @id @default(cuid())
  requestId    String
  tenantId     String
  keyId        String
  endpoint     String
  packId       String?
  packVersion  String?
  ruleVersions Json?
  inputsHash   String
  output       Json?
  model        String?
  test         Boolean
  createdAt    DateTime @default(now())

  @@unique([tenantId, requestId])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  tenantId     String
  key          String
  requestHash  String
  status       Int
  responseBody String
  createdAt    DateTime @default(now())

  @@unique([tenantId, key])
}

model WebhookEndpoint {
  id         String    @id @default(cuid())
  tenantId   String
  url        String
  events     String[]
  packs      String[]
  secret     String // TODO: encrypt at rest (needed in plaintext to sign)
  createdAt  DateTime  @default(now())
  disabledAt DateTime?

  @@index([tenantId])
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  tenantId       String
  endpointId     String
  event          String
  payload        String
  status         String // pending | succeeded | failed
  attempts       Int       @default(0)
  lastStatusCode Int?
  lastError      String?
  nextAttemptAt  DateTime?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([tenantId, endpointId])
}
